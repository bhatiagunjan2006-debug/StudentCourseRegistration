@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => (controller == c && action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marwadi University Student Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="top-ribbon d-none d-md-block">
        <div class="container d-flex justify-content-between">
            <span><i class="bi bi-geo-alt-fill me-1"></i>Main Campus &middot; Admissions &amp; Registrar Office</span>
            <span><i class="bi bi-envelope-fill me-1"></i>registrar&#64;marwadiuniversity.ac.in &nbsp;&middot;&nbsp; <i class="bi bi-clock-fill me-1"></i>Mon&ndash;Sat, 9:00 &ndash; 17:00</span>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark portal-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-text"><strong>Marwadi University</strong><small>Student Portal</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav ms-auto gap-lg-1 align-items-lg-center">
                    <li class="nav-item"><a class="nav-link @Active("Home","Index")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Student","Create")" asp-controller="Student" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Register</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Student","Index")" asp-controller="Student" asp-action="Index"><i class="bi bi-people me-1"></i>Students</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Home","About")" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-1"></i>About</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="portal-footer">
        <div class="container pt-5 pb-3">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h6 class="fs-5"><i class="bi bi-mortarboard-fill me-2" style="color:var(--gold)"></i>Marwadi University</h6>
                    <p class="mb-0">A modern student registration portal for enrolling students into programmes and semesters &mdash; simple, secure and elegant.</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled mb-0 lh-lg">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Student" asp-action="Create">Register Student</a></li>
                        <li><a asp-controller="Student" asp-action="Index">Student Directory</a></li>
                        <li><a asp-controller="Home" asp-action="About">About System</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6>Project</h6>
                    <p class="mb-0">B.Tech Computer Engineering &middot; Semester 5<br />.NET Technologies &middot; ASP.NET Core MVC</p>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex flex-column flex-md-row justify-content-between gap-1">
                <span>Student Course Registration System</span>
                <span>&copy; @DateTime.Now.Year Marwadi University Portal. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
