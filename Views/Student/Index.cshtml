@model List<Student>
@{
    ViewData["Title"] = "Student List";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4 reveal">
    <div>
        <span class="eyebrow">Directory</span>
        <h2><i class="bi bi-people-fill me-2"></i>Registered Students</h2>
        <p class="text-muted mb-0">Total: <strong>@Model.Count</strong><span id="filterInfo" class="ms-2"></span></p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus-fill me-1"></i>Register New Student</a>
</div>

<div class="portal-card p-0 overflow-hidden reveal">
    @if (Model.Count == 0)
    {
        <div class="empty-state text-center p-5">
            <i class="bi bi-inbox"></i>
            <h4 class="mt-3">No students registered yet</h4>
            <p class="text-muted">Start by registering the first student.</p>
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus-fill me-1"></i>Register New Student</a>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div class="search">
                <i class="bi bi-search"></i>
                <input type="search" id="searchBox" class="form-control" placeholder="Search by ID, name, email or course..." />
            </div>
            <select id="courseFilter" class="form-select" style="max-width:260px">
                <option value="">All courses</option>
                @foreach (var c in StudentController.Courses)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select id="semFilter" class="form-select" style="max-width:160px">
                <option value="">All semesters</option>
                @for (int i = 1; i <= 8; i++)
                {
                    <option value="@i">Semester @i</option>
                }
            </select>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 portal-table" id="studentTable">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Semester</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var searchText = (s.Id + " " + s.Name + " " + s.Email + " " + s.Course).ToLower();
                        <tr data-search="@searchText" data-course="@s.Course" data-sem="@s.Semester">
                            <td><span class="id-pill">@s.Id</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="mini-avatar">@s.Name.Substring(0, 1).ToUpper()</span>
                                    <strong>@s.Name</strong>
                                </div>
                            </td>
                            <td>@s.Email</td>
                            <td>@s.Course</td>
                            <td><span class="badge badge-soft">Sem @s.Semester</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@s.Id">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                            </td>
                        </tr>
                    }
                    <tr id="noMatchRow" class="d-none">
                        <td colspan="6" class="text-center text-muted py-5"><i class="bi bi-search me-2"></i>No students match your filters.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
