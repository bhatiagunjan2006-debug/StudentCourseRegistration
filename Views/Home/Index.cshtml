@model int
@{
    ViewData["Title"] = "Home";
    var courses = (string[])ViewBag.Courses;
    var counts = (Dictionary<string, int>)ViewBag.CourseCounts;
    var recent = (List<Student>)ViewBag.Recent;
}

<section class="hero-card mb-4 reveal">
    <div class="row align-items-center g-4 position-relative" style="z-index:1">
        <div class="col-lg-7">
            <span class="hero-chip mb-3"><i class="bi bi-stars"></i>Academic Year @DateTime.Now.Year &ndash; @((DateTime.Now.Year + 1) % 100)</span>
            <h1 class="mt-3">Welcome to <em>Student Registration</em> Portal</h1>
            <p class="lead my-4">Register students, choose programmes and semesters, and manage academic records &mdash; all in one elegant, effortless place.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-gold btn-lg" asp-controller="Student" asp-action="Create"><i class="bi bi-person-plus-fill me-1"></i>Register New Student</a>
                <a class="btn btn-glass btn-lg" asp-controller="Student" asp-action="Index"><i class="bi bi-people-fill me-1"></i>View Students</a>
                <a class="btn btn-glass btn-lg" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle-fill me-1"></i>About System</a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
            <div class="hero-panel">
                <small class="text-uppercase" style="letter-spacing:.15em">Live Enrolment</small>
                <div class="big my-1" data-count="@Model">@Model</div>
                <small>Registered students</small>
                <div class="mini mt-3"><span>Programmes offered</span><b>@courses.Length</b></div>
                <div class="mini"><span>Semesters per programme</span><b>8</b></div>
                <div class="mini"><span>Registration status</span><b><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Open</b></div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-4 reveal">
        <div class="portal-card stat-card h-100 lift">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-number" data-count="@Model">@Model</div>
                <div class="text-muted">Total Registered Students</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 reveal">
        <div class="portal-card stat-card h-100 lift">
            <div class="stat-icon gold"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div>
                <div class="stat-number" data-count="@courses.Length">@courses.Length</div>
                <div class="text-muted">Available Courses</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 reveal">
        <div class="portal-card stat-card h-100 lift">
            <div class="stat-icon sky"><i class="bi bi-calendar3"></i></div>
            <div>
                <div class="stat-number">8</div>
                <div class="text-muted">Semesters per Programme</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8 reveal">
        <div class="portal-card h-100">
            <span class="eyebrow">Programmes</span>
            <h4 class="section-title mb-3"><i class="bi bi-journal-text me-2"></i>Available Courses</h4>
            <div class="row g-3">
                @foreach (var c in courses)
                {
                    <div class="col-sm-6">
                        <div class="course-item">
                            <span class="ci"><i class="bi bi-book"></i></span>
                            <span>@c</span>
                            <span class="count" title="Students enrolled">@counts[c]</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4 reveal">
        <div class="portal-card h-100">
            <span class="eyebrow">Calendar</span>
            <h4 class="section-title mb-3"><i class="bi bi-calendar-event me-2"></i>Semester Information</h4>
            <ul class="list-unstyled mb-0 info-list">
                <li><i class="bi bi-check2-circle"></i> Odd Semesters: 1, 3, 5, 7 (July &ndash; Nov)</li>
                <li><i class="bi bi-check2-circle"></i> Even Semesters: 2, 4, 6, 8 (Jan &ndash; May)</li>
                <li><i class="bi bi-check2-circle"></i> Valid semester range: 1 to 8</li>
                <li><i class="bi bi-check2-circle"></i> Each student ID must be unique</li>
            </ul>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7 reveal">
        <div class="portal-card h-100">
            <span class="eyebrow">Activity</span>
            <h4 class="section-title mb-3"><i class="bi bi-clock-history me-2"></i>Recent Registrations</h4>
            @if (recent.Count == 0)
            {
                <div class="text-center py-4 empty-state">
                    <i class="bi bi-inbox"></i>
                    <p class="text-muted mb-3 mt-2">No registrations yet. Be the first to enrol a student.</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Student" asp-action="Create">Register Student</a>
                </div>
            }
            else
            {
                foreach (var s in recent)
                {
                    <a class="d-flex align-items-center gap-3 py-2 text-decoration-none border-bottom" style="border-color:var(--line)!important" asp-controller="Student" asp-action="Details" asp-route-id="@s.Id">
                        <span class="mini-avatar">@s.Name.Substring(0, 1).ToUpper()</span>
                        <span class="flex-grow-1">
                            <strong class="d-block text-dark">@s.Name</strong>
                            <small class="text-muted">@s.Course</small>
                        </span>
                        <span class="badge badge-soft">Sem @s.Semester</span>
                    </a>
                }
            }
        </div>
    </div>
    <div class="col-lg-5 reveal">
        <div class="portal-card h-100">
            <span class="eyebrow">Process</span>
            <h4 class="section-title mb-3"><i class="bi bi-signpost-split me-2"></i>How Registration Works</h4>
            <div class="timeline">
                <div class="t-item"><b>1. Enter details</b><div class="text-muted small">Student ID, full name and email address.</div></div>
                <div class="t-item"><b>2. Choose programme</b><div class="text-muted small">Select a course and the current semester.</div></div>
                <div class="t-item"><b>3. Instant validation</b><div class="text-muted small">Rules and duplicate IDs are checked automatically.</div></div>
                <div class="t-item mb-0 pb-0"><b>4. Confirmation</b><div class="text-muted small">View the student in the directory immediately.</div></div>
            </div>
        </div>
    </div>
</div>
